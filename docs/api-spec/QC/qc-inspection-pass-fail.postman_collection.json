		{
			"name": "❌ Use Case 4: Fail QC — REWORK (No Stock Movement)",
			"description": "QC Inspector fail với action = REWORK → status REWORK_REQUIRED, stock giữ nguyên QUALITY_INSPECTION, KHÔNG tạo stock movement.\n\n**Flow:**\n1. Tạo inspection\n2. Fail với REWORK\n3. Xác nhận REWORK_REQUIRED, stockMovementId = null",
			"item": [
				{
					"name": "[4A] Create test inspection (30 units)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success) pm.collectionVariables.set('reworkInspectionId', json.data.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
