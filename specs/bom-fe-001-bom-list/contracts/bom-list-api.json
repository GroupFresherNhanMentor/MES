{
  "openapi": "3.0.3",
  "info": {
    "title": "BOM List & Filter API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/boms": {
      "get": {
        "summary": "Fetch paginated BOM list with optional filters",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "finishedProductId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "bomStatusId", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "PageResponse of BomDto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": { "type": "array", "items": { "$ref": "#/components/schemas/BomDto" } },
                        "totalElements": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/boms/statuses": {
      "get": {
        "summary": "Fetch list of BOM statuses",
        "responses": {
          "200": {
            "description": "List of BOM status objects"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BomDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "finishedProductId": { "type": "string", "format": "uuid" },
          "finishedProductName": { "type": "string" },
          "finishedProductCode": { "type": "string" },
          "version": { "type": "integer" },
          "bomStatusId": { "type": "string" },
          "bomStatusName": { "type": "string" },
          "createdBy": { "type": "string" },
          "createdAt": { "type": "string" }
        }
      }
    }
  }
}
