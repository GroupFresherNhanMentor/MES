{
  "openapi": "3.0.3",
  "info": {
    "title": "Query BOMs API",
    "version": "1.0.0",
    "description": "API contract for querying BOM list (with pagination & filters) and retrieving BOM details."
  },
  "paths": {
    "/api/boms": {
      "get": {
        "summary": "Get paginated list of BOMs with optional filters",
        "operationId": "getBoms",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } },
          { "name": "finishedProductId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } },
          { "name": "bomStatusId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of BOM headers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": { "type": "array", "items": { "$ref": "#/components/schemas/BomDto" } },
                        "totalElements": { "type": "integer", "example": 15 },
                        "totalPages": { "type": "integer", "example": 1 },
                        "pageNumber": { "type": "integer", "example": 0 },
                        "pageSize": { "type": "integer", "example": 20 }
                      }
                    },
                    "message": { "type": "string", "example": "OK" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/boms/{id}": {
      "get": {
        "summary": "Get BOM details by ID including component line items",
        "operationId": "getBomById",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "BOM detail with items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/BomDto" },
                    "message": { "type": "string", "example": "OK" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "BOM not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BomDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "finishedProductId": { "type": "string", "format": "uuid" },
          "version": { "type": "integer" },
          "bomStatusId": { "type": "string", "format": "uuid" },
          "createdBy": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/BomItemDto" } }
        }
      },
      "BomItemDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "bomId": { "type": "string", "format": "uuid" },
          "materialProductId": { "type": "string", "format": "uuid" },
          "quantityPerUnit": { "type": "number" },
          "unit": { "type": "string" },
          "scrapRate": { "type": "number" }
        }
      }
    }
  }
}
